#!/usr/bin/env bash

set -euo pipefail

[ $# -eq 1 ] || { echo "Requires exactly one argument. Usage: $0 <version>, e.g. $0 1.2.3" >&2; exit 1; }
git diff-index --quiet HEAD -- || { echo "Working directory is not clean." >&2; exit 1; }

trap "git checkout $(git rev-parse --abbrev-ref HEAD) &>/dev/null || true" EXIT SIGINT SIGTERM

git checkout --detach

git push -u origin $(npm version $1)
